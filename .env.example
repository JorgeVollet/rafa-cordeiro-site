# ============================================================
# Exemplo de variáveis de ambiente — copie para `.env` e preencha.
#   cp .env.example .env
# Todas as variáveis expostas ao front-end DEVEM começar com VITE_.
# ============================================================

# Supabase (Fase 5)
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# WhatsApp de agendamento (55 + DDD + número, só dígitos)
VITE_WHATSAPP_NUMBER=5511999999999

# Formspree (Fase 3 — formulário de contato)
VITE_FORMSPREE_ID=xpzgabcd

# URL pública do site (SEO / canonical / sitemap)
VITE_SITE_URL=https://www.rafaelcordeiro.com.br
